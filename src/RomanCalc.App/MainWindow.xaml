<Window x:Class="RomanCalc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roman Calculator"
        Width="360" Height="520" MinWidth="320" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E24"
        KeyDown="Window_KeyDown"
        AutomationProperties.AutomationId="MainWindow">
    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#33333D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#C8963E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="FnButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Background" Value="#4A4A57"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <Border Grid.Row="0" Background="#14141A" CornerRadius="8" Padding="12" Margin="4,4,4,10">
            <StackPanel>
                <TextBlock x:Name="ExpressionText" AutomationProperties.AutomationId="Expression"
                           Foreground="#9A9AA8" FontSize="14" TextAlignment="Right" MinHeight="18"/>
                <TextBlock x:Name="DisplayText" AutomationProperties.AutomationId="Display"
                           Foreground="#F2F2F2" FontFamily="Georgia" FontSize="34" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" Text=""/>
                <TextBlock x:Name="DecimalText" AutomationProperties.AutomationId="Decimal"
                           Foreground="#7FB7A0" FontSize="13" TextAlignment="Right" MinHeight="16"/>
            </StackPanel>
        </Border>

        <!-- Keypad -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="M" Tag="M" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_M"/>
            <Button Grid.Row="0" Grid.Column="1" Content="D" Tag="D" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_D"/>
            <Button Grid.Row="0" Grid.Column="2" Content="C" Tag="C" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_C"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷" Tag="Divide" Click="Op_Click" Style="{StaticResource OpButton}" AutomationProperties.AutomationId="Btn_Divide" AutomationProperties.Name="Divide"/>

            <Button Grid.Row="1" Grid.Column="0" Content="L" Tag="L" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_L"/>
            <Button Grid.Row="1" Grid.Column="1" Content="X" Tag="X" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_X"/>
            <Button Grid.Row="1" Grid.Column="2" Content="V" Tag="V" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_V"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×" Tag="Multiply" Click="Op_Click" Style="{StaticResource OpButton}" AutomationProperties.AutomationId="Btn_Multiply" AutomationProperties.Name="Multiply"/>

            <Button Grid.Row="2" Grid.Column="0" Content="I" Tag="I" Click="Numeral_Click" Style="{StaticResource CalcButton}" AutomationProperties.AutomationId="Btn_I"/>
            <Button Grid.Row="2" Grid.Column="1" Content="⌫" Click="Back_Click" Style="{StaticResource FnButton}" AutomationProperties.AutomationId="Btn_Back" AutomationProperties.Name="Backspace"/>
            <Button Grid.Row="2" Grid.Column="2" Content="AC" Click="Clear_Click" Style="{StaticResource FnButton}" AutomationProperties.AutomationId="Btn_Clear" AutomationProperties.Name="Clear"/>
            <Button Grid.Row="2" Grid.Column="3" Content="−" Tag="Subtract" Click="Op_Click" Style="{StaticResource OpButton}" AutomationProperties.AutomationId="Btn_Subtract" AutomationProperties.Name="Subtract"/>

            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="=" Click="Equals_Click" Style="{StaticResource OpButton}" AutomationProperties.AutomationId="Btn_Equals" AutomationProperties.Name="Equals"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Tag="Add" Click="Op_Click" Style="{StaticResource OpButton}" AutomationProperties.AutomationId="Btn_Add" AutomationProperties.Name="Add"/>
        </Grid>
    </Grid>
</Window>
